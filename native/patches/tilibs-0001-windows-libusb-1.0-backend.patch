diff --git a/libticables/trunk/src/win32/detect.cc b/libticables/trunk/src/win32/detect.cc
index 64f5671..4d85def 100644
--- a/libticables/trunk/src/win32/detect.cc
+++ b/libticables/trunk/src/win32/detect.cc
@@ -89,6 +89,16 @@ int win32_check_rwp(void)
 #endif
 }
 
+#ifdef HAVE_LIBUSB_1_0
+// libusb-1.0 backend (WinUSB / libusbK / libusb0.sys drivers): USB is usable if
+// libusb_init() succeeded in ticables_library_init().
+extern int libusb_working;
+
+int win32_check_libusb(void)
+{
+	return (libusb_working == 0) ? 0 : ERR_LIBUSBWIN32_NOT_PRESENT;
+}
+#else
 int win32_check_libusb(void)
 {
 	if(usb_get_version() != NULL)
@@ -96,3 +106,4 @@ int win32_check_libusb(void)
 	else
 		return ERR_LIBUSBWIN32_NOT_PRESENT;
 }
+#endif
