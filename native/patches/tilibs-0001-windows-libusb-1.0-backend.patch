diff --git a/libticables/trunk/CMakeLists.txt b/libticables/trunk/CMakeLists.txt
index a957745..0531005 100644
--- a/libticables/trunk/CMakeLists.txt
+++ b/libticables/trunk/CMakeLists.txt
@@ -61,7 +61,11 @@ if(LINUX)
 endif()
 
 # external deps lookup
-if(WIN32)
+# On Windows, USB goes through libusb-win32 (libusb0.sys driver) by default. With
+# TICABLES_WIN32_LIBUSB1=ON it uses the libusb-1.0 backend instead (as on Linux/macOS),
+# which works with the WinUSB driver (inbox, Microsoft-signed, ARM64-capable).
+option(TICABLES_WIN32_LIBUSB1 "Windows: use libusb-1.0 (WinUSB) instead of libusb-win32" OFF)
+if(WIN32 AND NOT TICABLES_WIN32_LIBUSB1)
     find_library(LIBUSB0 NAMES libusb0.lib usb0 REQUIRED)
     target_link_libraries(ticables2 PRIVATE ${LIBUSB0})
 else()
@@ -74,6 +78,8 @@ target_link_libraries(ticables2 PRIVATE PkgConfig::glib)
 if(NOT WIN32)
     # additional internal defines
     target_compile_definitions(ticables2 PUBLIC HAVE_LIBUSB_1_0=1 HAVE_LIBUSB10_STRERROR=1 HAVE_TERMIOS_H=1)
+elseif(TICABLES_WIN32_LIBUSB1)
+    target_compile_definitions(ticables2 PUBLIC HAVE_LIBUSB_1_0=1 HAVE_LIBUSB10_STRERROR=1)
 endif()
 
 set_target_properties(ticables2 PROPERTIES VERSION 8.0.0 SOVERSION 8)
