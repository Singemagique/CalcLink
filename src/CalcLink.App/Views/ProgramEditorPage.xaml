<?xml version="1.0" encoding="utf-8"?>
<!-- Write or edit a TI-BASIC program on the PC; checked as you type. -->
<Page
    x:Class="CalcLink.App.Views.ProgramEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="SymbolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Program editor" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Write or change a TI-BASIC program, then save it as a file or send it to the calculator. Type -&gt; for →, &lt;= for ≤ and &gt;= for ≥, or use the symbol buttons." />
        </StackPanel>

        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton Label="New" Icon="Page2" Command="{x:Bind ViewModel.NewCommand}" />
            <AppBarButton Label="Open file…" Icon="OpenFile" Command="{x:Bind ViewModel.OpenFileCommand}"
                          ToolTipService.ToolTip="Open a program file (.8xp) (Ctrl+O)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Save as…" Icon="Save" Command="{x:Bind ViewModel.SaveAsCommand}"
                          ToolTipService.ToolTip="Save the program as an .8xp file (Ctrl+S)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Send to calculator" Icon="Upload" Command="{x:Bind ViewModel.SendCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SendTip, Mode=OneWay}" />
        </CommandBar>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Name" Width="160" MaxLength="8" CharacterCasing="Upper" IsSpellCheckEnabled="False"
                     FontFamily="Cascadia Mono, Consolas"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="1" VerticalAlignment="Bottom" Content="Protected"
                      IsChecked="{x:Bind ViewModel.IsProtected, Mode=TwoWay}"
                      ToolTipService.ToolTip="A protected program can be run but not edited on the calculator" />
            <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="{x:Bind ViewModel.Source, Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind ViewModel.Source, Mode=OneWay}" />
        </Grid>

        <!-- Characters that aren't on a PC keyboard. Each button inserts its text at the cursor. -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
            <StackPanel x:Name="SymbolBar" Orientation="Horizontal" Spacing="4" Padding="0,0,0,4" />
        </ScrollViewer>

        <StackPanel Grid.Row="4" Spacing="8">
            <InfoBar Severity="Error" IsClosable="False" Title="Not valid TI-BASIC"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Go to error" Click="OnGoToErrorClick" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Severity="Warning" IsClosable="True" Title="Saving may change this program"
                     IsOpen="{x:Bind ViewModel.ShowLookalikeWarning, Mode=TwoWay}"
                     Message="It uses characters that look the same as others, such as the statistics result e and the letter e. Saved from here, they become the ordinary letter, so the program may behave differently." />
        </StackPanel>

        <TextBox x:Name="CodeBox" Grid.Row="5" AcceptsReturn="True" TextWrapping="NoWrap" IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PlaceholderText="Type your program here, one command per line. For example:&#x0d;ClrHome&#x0d;Disp &quot;HELLO&quot;"
                 AutomationProperties.Name="Program text"
                 Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 SelectionChanged="OnCodeSelectionChanged" />

        <Grid Grid.Row="6" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CaretText" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" Text="Unsaved changes"
                       Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
