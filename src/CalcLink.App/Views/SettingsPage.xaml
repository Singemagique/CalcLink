<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalcLink.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:h="using:CalcLink.App.Helpers"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox Header="Theme" MinWidth="200" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <x:String>Use system setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Calculator backend" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.BackendIndex, Mode=TwoWay}" AutomationProperties.Name="Calculator backend">
                        <x:String>Automatic (native if available, otherwise simulator)</x:String>
                        <x:String>Native (real calculators via tilibs)</x:String>
                        <x:String>Simulator (no hardware)</x:String>
                    </RadioButtons>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{x:Bind ViewModel.CurrentBackendText, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}" IsClosable="False" Severity="Informational"
                             Title="Restart required" Message="Restart CalcLink to switch to the selected backend.">
                        <InfoBar.ActionButton>
                            <Button Content="Restart now" Command="{x:Bind ViewModel.RestartCommand}"
                                    ToolTipService.ToolTip="Close and reopen CalcLink with the selected backend" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Transfers" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ReceiveFolderLabel" Text="Default receive folder" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE838;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- Plain text, not a read-only TextBox, so it doesn't look editable. -->
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True"
                                       AutomationProperties.LabeledBy="{x:Bind ReceiveFolderLabel}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.DefaultReceiveFolderText, Mode=OneWay}"
                                       Text="{x:Bind ViewModel.DefaultReceiveFolderText, Mode=OneWay}" />
                            <Button Grid.Column="2" VerticalAlignment="Center" Content="Browse…"
                                    AutomationProperties.Name="Browse for default receive folder"
                                    Command="{x:Bind ViewModel.BrowseFolderCommand}" />
                            <Button Grid.Column="3" VerticalAlignment="Center" Content="Clear"
                                    Command="{x:Bind ViewModel.ClearFolderCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasDefaultFolder, Mode=OneWay}"
                                    AutomationProperties.Name="Clear default receive folder" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Used by &#x201C;Receive to default folder&#x201D; on the Calculator page, which saves there without asking." />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="BackupFolderLabel" Text="Backups folder" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE838;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True"
                                       AutomationProperties.LabeledBy="{x:Bind BackupFolderLabel}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.BackupFolderText, Mode=OneWay}"
                                       Text="{x:Bind ViewModel.BackupFolderText, Mode=OneWay}" />
                            <Button Grid.Column="2" VerticalAlignment="Center" Content="Browse…"
                                    AutomationProperties.Name="Browse for backups folder"
                                    Command="{x:Bind ViewModel.BrowseBackupFolderCommand}" />
                            <Button Grid.Column="3" VerticalAlignment="Center" Content="Reset"
                                    Command="{x:Bind ViewModel.ResetBackupFolderCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasCustomBackupFolder, Mode=OneWay}"
                                    ToolTipService.ToolTip="Use Documents\CalcLink Backups"
                                    AutomationProperties.Name="Reset backups folder to the default" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="&#x201C;Back up now&#x201D; on the Tools page saves here, in a subfolder for each calculator. Existing backups aren't moved when you change it." />
                    </StackPanel>
                    <NumberBox Header="Link timeout (seconds)" HorizontalAlignment="Left" MinWidth="200"
                               Minimum="0.5" Maximum="60" SmallChange="0.5" LargeChange="5"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind ViewModel.LinkTimeoutSeconds, Mode=TwoWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="How long to wait for the calculator to answer before giving up. Increase it for slow or busy calculators. Applies to new connections." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="About CalcLink" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.VersionText}" IsTextSelectionEnabled="True" />
                    <TextBlock TextWrapping="Wrap"
                               Text="CalcLink links TI graphing calculators (TI-84 Plus CE, TI-Nspire, TI-89 and more) to your PC." />
                    <TextBlock TextWrapping="Wrap"
                               Text="Built on tilibs by Romain Liévin, Kevin Kofler, Lionel Debroux and contributors." />
                    <Expander Header="License" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 2 of the License, or (at your option) any later version. It is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE." />
                            <HyperlinkButton Content="GNU General Public License, version 2" Padding="0"
                                             NavigateUri="https://www.gnu.org/licenses/old-licenses/gpl-2.0.html" />
                        </StackPanel>
                    </Expander>
                    <HyperlinkButton Content="Open settings folder" Padding="0"
                                     Command="{x:Bind ViewModel.OpenSettingsFolderCommand}"
                                     ToolTipService.ToolTip="{x:Bind ViewModel.SettingsPath}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Text="TI-84 Plus, TI-Nspire and TI-89 are trademarks of Texas Instruments. CalcLink is not affiliated with Texas Instruments." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
