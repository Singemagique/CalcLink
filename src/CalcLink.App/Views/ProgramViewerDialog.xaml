<?xml version="1.0" encoding="utf-8"?>
<!-- Shows a program read from the calculator: TI-BASIC as text with line numbers, assembly as hex. -->
<ContentDialog
    x:Class="CalcLink.App.Views.ProgramViewerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Copy"
    SecondaryButtonText="Save as…"
    CloseButtonText="Close"
    DefaultButton="Close"
    PrimaryButtonClick="OnCopyClick"
    SecondaryButtonClick="OnSaveClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="10" MinWidth="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DetailsText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="EditButton" Grid.Column="1" Visibility="Collapsed" Click="OnEditClick"
                    AutomationProperties.Name="Edit"
                    ToolTipService.ToolTip="Open this program in the program editor">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    <TextBlock Text="Edit" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="AssemblyInfo" Grid.Row="1" Severity="Informational" IsClosable="False"
                 Title="Assembly program" />

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="4" Padding="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <ScrollViewer x:Name="Scroller" MaxHeight="480" HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Padding="12,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Line numbers: not selectable, so copying a selection gives code only. -->
                    <TextBlock x:Name="LineNumbers" TextAlignment="Right" IsTextSelectionEnabled="False"
                               FontFamily="Cascadia Mono, Consolas" FontSize="13"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="Code" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="NoWrap"
                               FontFamily="Cascadia Mono, Consolas" FontSize="13"
                               AutomationProperties.Name="Program listing" />
                </Grid>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource SecondaryCaptionTextStyle}"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</ContentDialog>
