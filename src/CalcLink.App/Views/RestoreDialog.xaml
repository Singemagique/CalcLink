<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from a dated backup: pick the items to send back (only missing ones are pre-selected). -->
<ContentDialog
    x:Class="CalcLink.App.Views.RestoreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CalcLink.App.ViewModels"
    Title="Restore from backup"
    PrimaryButtonText="Restore"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">

    <ContentDialog.Resources>
        <!-- Room for the item list: the default dialog is too narrow for four columns. -->
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="10" MinWidth="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.IntroText}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Select:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <HyperlinkButton Content="Not on calculator" Command="{x:Bind ViewModel.SelectMissingCommand}" />
            <HyperlinkButton Content="All" Command="{x:Bind ViewModel.SelectAllCommand}" />
            <HyperlinkButton Content="None" Command="{x:Bind ViewModel.SelectNoneCommand}" />
        </StackPanel>

        <ListView Grid.Row="2" MaxHeight="340" SelectionMode="None"
                  ItemsSource="{x:Bind ViewModel.Rows}"
                  AutomationProperties.Name="Items in the backup">
            <ListView.Header>
                <Grid Padding="12,0,12,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Item" Style="{StaticResource SecondaryCaptionTextStyle}" Margin="32,0,0,0" />
                    <TextBlock Grid.Column="1" Text="Size" Style="{StaticResource SecondaryCaptionTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Was in" Style="{StaticResource SecondaryCaptionTextStyle}" />
                    <TextBlock Grid.Column="3" Text="Now" Style="{StaticResource SecondaryCaptionTextStyle}" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RestoreRow">
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanRestore}"
                                  AutomationProperties.Name="{x:Bind AutomationName}" MinWidth="0">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind TypeText}" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{x:Bind LocationText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind StatusText}" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="4" Spacing="8">
            <InfoBar Severity="Warning" IsClosable="False" Title="May not fit"
                     IsOpen="{x:Bind ViewModel.ShowRamWarning, Mode=OneWay}"
                     Message="{x:Bind ViewModel.RamWarningText, Mode=OneWay}" />
            <InfoBar Severity="Informational" IsClosable="False" Title="Archived items arrive in RAM"
                     IsOpen="{x:Bind ViewModel.ShowArchiveNote, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ArchiveNoteText}" />
        </StackPanel>
    </Grid>
</ContentDialog>
