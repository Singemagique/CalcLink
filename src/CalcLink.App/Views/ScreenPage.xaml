<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalcLink.App.Views.ScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:h="using:CalcLink.App.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,8" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Screen" Style="{StaticResource PageTitleStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CaptureCommand}"
                    AutomationProperties.Name="Capture"
                    ToolTipService.ToolTip="{x:Bind ViewModel.CaptureTip, Mode=OneWay}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE722;" FontSize="16" />
                    <TextBlock Text="Capture" />
                </StackPanel>
            </Button>
            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.ShowCaptureProgress, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.ShowCaptureProgress, Mode=OneWay}"
                          AutomationProperties.Name="Capturing the screen" />
            <ToggleButton IsChecked="{x:Bind ViewModel.IsLive, Mode=TwoWay}"
                          AutomationProperties.Name="Live view"
                          IsEnabled="{x:Bind ViewModel.CanToggleLive, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.LiveTip, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE714;" FontSize="16" />
                    <TextBlock Text="Live" />
                </StackPanel>
            </ToggleButton>
            <ComboBox ItemsSource="{x:Bind ViewModel.Zooms}" SelectedIndex="{x:Bind ViewModel.ZoomIndex, Mode=TwoWay}"
                      MinWidth="90" AutomationProperties.Name="Zoom" ToolTipService.ToolTip="Zoom" />
            <AppBarSeparator />
            <Button Command="{x:Bind ViewModel.CopyCommand}" AutomationProperties.Name="Copy to clipboard"
                    ToolTipService.ToolTip="Copy to clipboard (Ctrl+C)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="C" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
            </Button>
            <Button Command="{x:Bind ViewModel.SaveCommand}" AutomationProperties.Name="Save as PNG"
                    ToolTipService.ToolTip="Save as PNG (Ctrl+S)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE74E;" FontSize="16" />
            </Button>
        </StackPanel>

        <ScrollViewer x:Name="Viewport" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ZoomMode="Disabled" SizeChanged="OnViewportSizeChanged">
            <Grid>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay}">
                    <Image Source="{x:Bind ViewModel.Bitmap, Mode=OneWay}" Stretch="Fill"
                           Width="{x:Bind ViewModel.DisplayWidth, Mode=OneWay}"
                           Height="{x:Bind ViewModel.DisplayHeight, Mode=OneWay}"
                           AutomationProperties.Name="Calculator screen" />
                </Border>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Press Capture to grab the calculator screen, or turn on Live for a continuous view."
                           Visibility="{x:Bind h:Format.CollapsedIf(ViewModel.HasImage), Mode=OneWay}" />
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
