<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalcLink.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CalcLink.App.ViewModels"
    xmlns:h="using:CalcLink.App.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- One line of the "Calculator not found?" checklist. -->
        <Style x:Key="CheckNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Devices" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Connect a TI graphing calculator with a USB cable (or a SilverLink / serial link), switch it on, then scan." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <!-- Files passed on the command line ("Open with CalcLink") wait here until a connection exists. -->
            <InfoBar Severity="Informational" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.Pending.HasPending, Mode=OneWay}"
                     Title="{x:Bind ViewModel.Pending.Title, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Pending.Summary, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Discard" Command="{x:Bind ViewModel.Pending.DiscardCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Severity="Error" IsClosable="False"
                     Title="Calculator backend unavailable"
                     IsOpen="{x:Bind ViewModel.HasBackendError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.BackendError, Mode=OneWay}" />
            <InfoBar Severity="Informational" IsClosable="True"
                     Title="Simulator mode"
                     Message="{x:Bind ViewModel.SimulatorMessage}"
                     IsOpen="{x:Bind ViewModel.IsSimulator, Mode=OneWay}" />
            <!-- A TI calculator or cable is plugged in with a driver CalcLink can't use (usually TI
                 Connect's). The scan may still list it (libusb sees it but can't talk to it), so this
                 sits above the list rather than in the "not found" help. -->
            <InfoBar Severity="Warning" IsClosable="False" Title="USB driver needed"
                     IsOpen="{x:Bind ViewModel.NeedsDriver, Mode=OneWay}"
                     Message="{x:Bind ViewModel.DriverProblemText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.SetUpDriverCommand}"
                            AutomationProperties.Name="Set up USB driver"
                            ToolTipService.ToolTip="Assigns WinUSB to the device. Windows asks for administrator permission.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontSize="16" />
                            <TextBlock Text="Set up USB driver…" />
                        </StackPanel>
                    </Button>
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"
                                 Visibility="{x:Bind ViewModel.IsSettingUpDriver, Mode=OneWay}" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar Severity="Warning" IsClosable="True"
                     Title="Scan failed"
                     IsOpen="{x:Bind ViewModel.HasScanError, Mode=TwoWay}"
                     Message="{x:Bind ViewModel.ScanError, Mode=OneWay}" />
        </StackPanel>

        <!-- Connecting is per row (button or double-click); the toolbar only scans. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ScanCommand}"
                    AutomationProperties.Name="Scan"
                    ToolTipService.ToolTip="Scan for connected calculators (F5)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                    <TextBlock Text="Scan" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.ConnectManuallyCommand}"
                    AutomationProperties.Name="Set up a connection"
                    ToolTipService.ToolTip="Connect through a gray serial TI-Graph Link, or choose the model of a calculator that didn't answer the scan">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <TextBlock Text="Set up a connection…" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="3">
            <ListView x:Name="DevicesList"
                      ItemsSource="{x:Bind ViewModel.Devices}"
                      SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="False"
                      DoubleTapped="OnDeviceDoubleTapped"
                      AutomationProperties.Name="Detected calculators">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItem">
                        <Grid Padding="4,10" ColumnSpacing="16" AutomationProperties.Name="{x:Bind Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8EF;" FontSize="28" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ModelText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind ShowModelText}" />
                                <TextBlock Text="{x:Bind Details}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center"
                                        Visibility="{x:Bind IsConnected, Mode=OneWay}">
                                    <TextBlock Text="Connected" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Button Content="Connect" Tag="{x:Bind}" Click="OnConnectClick"
                                        AutomationProperties.Name="{x:Bind ConnectAutomationName}"
                                        Visibility="{x:Bind IsNotConnected, Mode=OneWay}" />
                                <Button Content="Disconnect" Tag="{x:Bind}" Click="OnDisconnectClick"
                                        AutomationProperties.Name="{x:Bind DisconnectAutomationName}"
                                        ToolTipService.ToolTip="Close the connection to this calculator"
                                        Visibility="{x:Bind IsConnected, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state: progress while scanning, then a troubleshooting checklist if nothing was found. -->
            <ScrollViewer Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="12" MaxWidth="560"
                            Padding="0,16,0,8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="32" Height="32"
                                  Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />

                    <Expander x:Name="TroubleshootingExpander" Header="Calculator not found?" IsExpanded="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind ViewModel.ShowTroubleshooting, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock TextWrapping="Wrap" Text="Check these, then scan again:" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1." Style="{StaticResource CheckNumberStyle}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                           Text="The calculator is switched on and showing its home screen (on a TI-83/84: 2nd, QUIT, then CLEAR)." />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2." Style="{StaticResource CheckNumberStyle}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                           Text="The cable is pushed firmly into both the PC and the calculator. A SilverLink plug must go in past the first click. Some USB cables only carry power; try another one." />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="3." Style="{StaticResource CheckNumberStyle}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                           Text="TI Connect, TI Connect CE and TI-Nspire Computer Link are closed. While they run, they keep the calculator to themselves." />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="4." Style="{StaticResource CheckNumberStyle}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="The WinUSB driver is set up. CalcLink can't use TI's own driver: SilverLink cables and calculators used with TI Connect need WinUSB, set up once. When CalcLink sees such a device, it shows a Set up USB driver button at the top of this page; you can also do it yourself with Zadig." />
                                    <HyperlinkButton Content="How to install the driver" Padding="0"
                                                     Click="OnDriverHelpClick" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="5." Style="{StaticResource CheckNumberStyle}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                           Text="Using a gray serial TI-Graph Link? Scan can't find it: choose Set up a connection, then its COM port." />
                            </Grid>

                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ScanCommand}"
                                    AutomationProperties.Name="Scan again">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                    <TextBlock Text="Scan again" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
