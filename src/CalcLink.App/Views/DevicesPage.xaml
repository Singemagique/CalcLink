<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalcLink.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CalcLink.App.ViewModels"
    xmlns:h="using:CalcLink.App.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Devices" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Connect a TI graphing calculator with a USB cable (or a SilverLink / serial link), switch it on, then scan." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <!-- Files passed on the command line ("Open with CalcLink") wait here until a connection exists. -->
            <InfoBar Severity="Informational" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.Pending.HasPending, Mode=OneWay}"
                     Title="{x:Bind ViewModel.Pending.Title, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Pending.Summary, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Discard" Command="{x:Bind ViewModel.Pending.DiscardCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Severity="Error" IsClosable="False"
                     Title="Calculator backend unavailable"
                     IsOpen="{x:Bind ViewModel.HasBackendError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.BackendError, Mode=OneWay}" />
            <InfoBar Severity="Informational" IsClosable="True"
                     Title="Simulator mode"
                     Message="{x:Bind ViewModel.SimulatorMessage}"
                     IsOpen="{x:Bind ViewModel.IsSimulator, Mode=OneWay}" />
            <InfoBar Severity="Warning" IsClosable="True"
                     Title="Scan failed"
                     IsOpen="{x:Bind ViewModel.HasScanError, Mode=TwoWay}"
                     Message="{x:Bind ViewModel.ScanError, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ScanCommand}"
                    AutomationProperties.Name="Scan"
                    ToolTipService.ToolTip="Scan for connected calculators (F5)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                    <TextBlock Text="Scan" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.ConnectCommand}"
                    AutomationProperties.Name="Connect to selected calculator"
                    ToolTipService.ToolTip="Connect to the selected device">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE703;" FontSize="16" />
                    <TextBlock Text="Connect" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7"
                       Text="{x:Bind ViewModel.BackendText, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="DevicesList"
                      ItemsSource="{x:Bind ViewModel.Devices}"
                      SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="False"
                      DoubleTapped="OnDeviceDoubleTapped"
                      AutomationProperties.Name="Detected calculators">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItem">
                        <Grid Padding="4,10" ColumnSpacing="16" AutomationProperties.Name="{x:Bind Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8EF;" FontSize="28" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ModelText}" Opacity="0.8" />
                                <TextBlock Text="{x:Bind Details}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Connect" Tag="{x:Bind}" Click="OnConnectClick"
                                    AutomationProperties.Name="{x:Bind ConnectAutomationName}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="32" Height="32" />
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" Opacity="0.7"
                           Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
