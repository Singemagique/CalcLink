<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalcLink.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CalcLink.App.ViewModels"
    xmlns:h="using:CalcLink.App.Helpers"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Tools" Style="{StaticResource PageTitleStyle}" />

            <!-- Calculator information -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Calculator information" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshInfoCommand}"
                                AutomationProperties.Name="Refresh calculator information"
                                ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind ViewModel.ShowPython, Mode=OneWay}">
                            <TextBlock Text="Python" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind ViewModel.ShowExactMath, Mode=OneWay}">
                            <TextBlock Text="Exact math" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind ViewModel.ShowColor, Mode=OneWay}">
                            <TextBlock Text="Colour screen" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ViewModel.ShowBatteryOk, Mode=OneWay}">
                            <TextBlock Text="Battery OK" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SystemFillColorCriticalBrush}"
                                Visibility="{x:Bind ViewModel.ShowBatteryLow, Mode=OneWay}">
                            <TextBlock Text="Battery low" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.InfoRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoRow">
                                <Grid ColumnSpacing="16" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" Opacity="0.7" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Opacity="0.7" Text="No information available yet. Press Refresh to read it from the calculator."
                               TextWrapping="Wrap" Visibility="{x:Bind ViewModel.NoInfo, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Clock -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Clock" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ViewModel.ClockNote, Mode=OneWay}"
                               Visibility="{x:Bind h:Format.VisibleIfNotEmpty(ViewModel.ClockNote), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Calculator time:" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <DatePicker Date="{x:Bind ViewModel.ClockDate, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanClock, Mode=OneWay}"
                                    AutomationProperties.Name="Date to set" />
                        <TimePicker Time="{x:Bind ViewModel.ClockTime, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanClock, Mode=OneWay}"
                                    AutomationProperties.Name="Time to set" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Read" Command="{x:Bind ViewModel.ReadClockCommand}" />
                        <Button Content="Set" Command="{x:Bind ViewModel.SetClockCommand}" />
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SyncClockCommand}"
                                ToolTipService.ToolTip="Set the calculator clock to this PC's current time">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="Sync with PC" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup / ROM -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Backup and ROM" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="A backup saves all variables (TI group .tig, or the model's native backup format). A ROM dump creates an image of the calculator's software for use with an emulator." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{x:Bind ViewModel.BackupCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="Backup…" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="{x:Bind ViewModel.BackupNote, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{x:Bind ViewModel.DumpRomCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                <TextBlock Text="ROM dump…" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="{x:Bind ViewModel.RomNote, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- OS upgrade -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Operating system" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Before upgrading"
                             Message="Use fresh or fully charged batteries and do not unplug the cable until the transfer has finished." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{x:Bind ViewModel.SendOsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="Send OS…" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="{x:Bind ViewModel.OsNote, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
