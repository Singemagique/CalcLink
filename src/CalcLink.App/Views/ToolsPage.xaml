<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalcLink.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CalcLink.App.ViewModels"
    xmlns:h="using:CalcLink.App.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Secondary text uses theme brushes, not Opacity, so it follows High Contrast themes. -->
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- "Not available" notes: an info icon plus secondary text (see NoteGrid usages below). -->
        <Style x:Key="NoteIconStyle" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE946;" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- Narrow windows: stack the date and time pickers so neither is clipped. -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ClockPickers.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Tools" Style="{StaticResource PageTitleStyle}" />

            <!-- Calculator information -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Calculator information" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshInfoCommand}"
                                AutomationProperties.Name="Refresh calculator information"
                                ToolTipService.ToolTip="Refresh (F5)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <InfoBar IsOpen="{x:Bind ViewModel.ShowBatteryLow, Mode=OneWay}" IsClosable="False" Severity="Warning"
                             Title="Battery low"
                             Message="Charge or replace the batteries before a backup, ROM dump or OS upgrade." />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind ViewModel.ShowPython, Mode=OneWay}">
                            <TextBlock Text="Python" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind ViewModel.ShowExactMath, Mode=OneWay}">
                            <TextBlock Text="Exact math" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind ViewModel.ShowColor, Mode=OneWay}">
                            <TextBlock Text="Colour screen" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.InfoRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoRow">
                                <Grid ColumnSpacing="16" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Text="No information available yet. Press Refresh (F5) to read it from the calculator."
                               Visibility="{x:Bind ViewModel.NoInfo, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Clock: on models without one the card is just its title and a one-line note. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Clock" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8" Visibility="{x:Bind h:Format.VisibleIfNotEmpty(ViewModel.ClockNote), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource NoteIconStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ClockNote, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasClock, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Calculator time:" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel x:Name="ClockPickers" Orientation="Vertical" Spacing="8">
                            <DatePicker Date="{x:Bind ViewModel.ClockDate, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanClock, Mode=OneWay}"
                                        AutomationProperties.Name="Date to set" />
                            <TimePicker Time="{x:Bind ViewModel.ClockTime, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanClock, Mode=OneWay}"
                                        AutomationProperties.Name="Time to set" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ReadClockCommand}"
                                    ToolTipService.ToolTip="Read the calculator's date and time">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE823;" FontSize="14" />
                                    <TextBlock Text="Read" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.SetClockCommand}"
                                    ToolTipService.ToolTip="Set the calculator clock to the date and time above">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE787;" FontSize="14" />
                                    <TextBlock Text="Set" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.SyncClockCommand}"
                                    ToolTipService.ToolTip="Set the calculator clock to this PC's current time">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="14" />
                                    <TextBlock Text="Sync with PC" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backups: one click to a dated file per calculator, the list of past backups, restore. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Backups" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Text="{x:Bind ViewModel.Backups.BackupDescription, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.Backups.BackUpNowCommand}"
                                AutomationProperties.Name="Back up now">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA35;" FontSize="14" />
                                <TextBlock Text="Back up now" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.Backups.SaveAsCommand}"
                                ToolTipService.ToolTip="Choose where to save the backup, and its format">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE792;" FontSize="14" />
                                <TextBlock Text="Save as…" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.Backups.OpenFolderCommand}"
                                Visibility="{x:Bind ViewModel.Connection.IsConnected, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Backups.FolderText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock Text="Open folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind ViewModel.Backups.Items}" SelectionMode="None" MaxHeight="320"
                              Visibility="{x:Bind ViewModel.Backups.HasBackups, Mode=OneWay}"
                              AutomationProperties.Name="Backups of this calculator">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupListItem">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE81C;" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Restore…" Tag="{x:Bind}" Click="OnRestoreClick"
                                                AutomationProperties.Name="{x:Bind RestoreAutomationName}" />
                                        <Button Tag="{x:Bind}" AutomationProperties.Name="{x:Bind MoreAutomationName}"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Show in folder" Tag="{x:Bind}" Click="OnShowInFolderClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE838;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Delete" Tag="{x:Bind}" Click="OnDeleteBackupClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="No backups of this calculator yet."
                               Visibility="{x:Bind ViewModel.Backups.ShowNoBackups, Mode=OneWay}" />

                    <Grid ColumnSpacing="8" Visibility="{x:Bind h:Format.VisibleIfNotEmpty(ViewModel.Backups.BackupNote), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource NoteIconStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Backups.BackupNote, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ROM -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="ROM image" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Text="A ROM dump creates an image of the calculator's software, for use with an emulator." />
                    <Button Command="{x:Bind ViewModel.DumpRomCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="14" />
                            <TextBlock Text="ROM dump…" />
                        </StackPanel>
                    </Button>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind h:Format.VisibleIfNotEmpty(ViewModel.RomNote), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource NoteIconStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.RomNote, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- OS upgrade -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Operating system" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.ShowOsWarning, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="Before upgrading"
                             Message="Use fresh or fully charged batteries and do not unplug the cable until the transfer has finished." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.SendOsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="Send OS…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind h:Format.VisibleIfNotEmpty(ViewModel.OsNote), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource NoteIconStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.OsNote, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
