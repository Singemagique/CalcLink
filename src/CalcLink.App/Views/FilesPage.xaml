<?xml version="1.0" encoding="utf-8"?>
<!-- F5: browse group, backup and variable files without a calculator. -->
<Page
    x:Class="CalcLink.App.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CalcLink.App.ViewModels"
    xmlns:h="using:CalcLink.App.Helpers">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Files" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Look inside TI groups, backups and variable files on this PC, no calculator needed. Read programs, save items on their own or as a new group, or send the ones you pick." />
        </StackPanel>

        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton Label="Open file…" Icon="OpenFile" Command="{x:Bind ViewModel.OpenFileCommand}"
                          ToolTipService.ToolTip="Open a .tig, .8xg or variable file (Ctrl+O)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Open program" Command="{x:Bind ViewModel.ViewCommand}"
                          ToolTipService.ToolTip="Show the selected program as text (Enter)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE943;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Save to folder…" Icon="Save" Command="{x:Bind ViewModel.SaveItemsCommand}"
                          ToolTipService.ToolTip="Save each selected item as a file of its own" />
            <AppBarButton Label="Save as group…" Command="{x:Bind ViewModel.SaveGroupCommand}"
                          ToolTipService.ToolTip="Save the selected variables together as one .8xg group file">
                <AppBarButton.Icon><FontIcon Glyph="&#xF156;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Send to calculator" Icon="Upload" Command="{x:Bind ViewModel.SendCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SendTip, Mode=OneWay}" />
        </CommandBar>

        <Grid Grid.Row="2" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.FilePath, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource SecondaryTextStyle}"
                       Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="ItemsList" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="Extended"
                      SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped" KeyDown="OnListKeyDown"
                      Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}"
                      AutomationProperties.Name="Items in the file">
                <ListView.Header>
                    <Grid Padding="16,0,16,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource SecondaryCaptionTextStyle}" Margin="36,0,0,0" />
                        <TextBlock Grid.Column="1" Text="Size" HorizontalAlignment="Right" Style="{StaticResource SecondaryCaptionTextStyle}" />
                        <TextBlock Grid.Column="2" Text="Was in" Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItemRow">
                        <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.Name="{x:Bind AutomationName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" FontSize="18" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind TypeText}" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind LocationText}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460"
                        Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="Open a file to see what's inside" />
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                           Text="CalcLink backups and TI groups (.tig), TI-83 Plus / TI-84 Plus group files (.8xg) and single variable files (.8xp, .8xl, ...). From Tools → Backups, &#x201C;Browse contents&#x201D; opens a backup here." />
                <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.OpenFileCommand}" AutomationProperties.Name="Open file">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="Open file…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
