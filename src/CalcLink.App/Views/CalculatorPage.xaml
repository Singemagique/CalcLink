<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalcLink.App.Views.CalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CalcLink.App.ViewModels"
    xmlns:h="using:CalcLink.App.Helpers"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">

    <Page.Resources>
        <Style x:Key="ColumnHeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- The two item templates differ only in the Type column (zero width when narrow), so the
             columns stay aligned with the header row in both states. -->
        <DataTemplate x:Key="WideItemTemplate" x:DataType="vm:VariableItem">
            <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          ToolTipService.ToolTip="{x:Bind TypeTip}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind TypeName}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind TypeTip}" />
                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" TextAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Background="Transparent" ToolTipService.ToolTip="{x:Bind LocationTip}">
                    <TextBlock Text="{x:Bind LocationText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon Glyph="{x:Bind LockGlyph}" FontSize="12" Visibility="{x:Bind HasLock}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NarrowItemTemplate" x:DataType="vm:VariableItem">
            <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          ToolTipService.ToolTip="{x:Bind TypeTip}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind TypeTip}" />
                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" TextAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Background="Transparent" ToolTipService.ToolTip="{x:Bind LocationTip}">
                    <TextBlock Text="{x:Bind LocationText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon Glyph="{x:Bind LockGlyph}" FontSize="12" Visibility="{x:Bind HasLock}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24,16,24,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Adaptive layout follows the page's own width (the navigation pane may take part of the window):
             below 640 DIP the Type column goes away, toolbar labels fold into tooltips and the View button
             shows only its icon. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates" CurrentStateChanged="OnWidthStateChanged">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <h:ElementWidthTrigger Target="{x:Bind RootGrid}" MinWidth="640" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <h:ElementWidthTrigger Target="{x:Bind RootGrid}" MaxWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TypeHeaderColumn.Width" Value="0" />
                        <Setter Target="TypeHeaderButton.Visibility" Value="Collapsed" />
                        <Setter Target="NameHeaderColumn.MinWidth" Value="80" />
                        <Setter Target="VariablesList.ItemTemplate" Value="{StaticResource NarrowItemTemplate}" />
                        <Setter Target="Toolbar.DefaultLabelPosition" Value="Collapsed" />
                        <Setter Target="ReceiveLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ViewButtonLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShowBox.Width" Value="150" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Header + memory summary. The model name is already in the title bar, status bar and Devices. -->
        <StackPanel>
            <TextBlock Text="Calculator" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind h:Format.VisibleIfNotEmpty(ViewModel.MemoryText), Mode=OneWay}" />
            <InfoBar Margin="0,8,0,0" Severity="Informational" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.Pending.HasPending, Mode=OneWay}"
                     Title="{x:Bind ViewModel.Pending.Title, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Pending.Summary, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Discard" Command="{x:Bind ViewModel.Pending.DiscardCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Commands. Commands the model can't do are hidden; selection-dependent ones are disabled. -->
        <CommandBar x:Name="Toolbar" Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True" Background="Transparent">
            <AppBarButton Label="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.RefreshTip, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Send files…" Icon="Upload" Command="{x:Bind ViewModel.SendFilesCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SendTip, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!-- Receive: main part picks a folder; the flyout receives to the default folder. -->
            <AppBarElementContainer VerticalAlignment="Center" IsTabStop="False">
                <SplitButton x:Name="ReceiveButton" Margin="2,0" Padding="10,5,8,6"
                             Background="Transparent" BorderThickness="0"
                             Command="{x:Bind ViewModel.ReceiveCommand}"
                             ToolTipService.ToolTip="{x:Bind ViewModel.ReceiveTip, Mode=OneWay}"
                             AutomationProperties.Name="Receive">
                    <SplitButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnReceiveAcceleratorInvoked" />
                    </SplitButton.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                        <TextBlock x:Name="ReceiveLabel" Text="Receive…" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Receive to folder…" Command="{x:Bind ViewModel.ReceiveCommand}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.ReceiveToDefaultText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ReceiveToDefaultCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.ReceiveToDefaultTip, Mode=OneWay}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE840;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </AppBarElementContainer>
            <AppBarSeparator />
            <!-- Del is handled by the list (OnListKeyDown) so typing in Find never deletes. -->
            <AppBarButton Label="Delete" Icon="Delete" Command="{x:Bind ViewModel.DeleteCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.DeleteTip, Mode=OneWay}" />
            <AppBarButton Label="Rename" Icon="Rename" Command="{x:Bind ViewModel.RenameCommand}"
                          Visibility="{x:Bind ViewModel.ShowRename, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.RenameTip}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F2" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Archive" Command="{x:Bind ViewModel.ArchiveCommand}"
                          Visibility="{x:Bind ViewModel.ShowArchive, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.ArchiveTip}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Move to RAM" Command="{x:Bind ViewModel.UnarchiveCommand}"
                          Visibility="{x:Bind ViewModel.ShowArchive, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.UnarchiveTip}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE950;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="New folder" Icon="NewFolder" Command="{x:Bind ViewModel.NewFolderCommand}"
                          Visibility="{x:Bind ViewModel.ShowNewFolder, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.NewFolderTip}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="N" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Run" Icon="Play" Command="{x:Bind ViewModel.RunCommand}"
                          Visibility="{x:Bind ViewModel.ShowRun, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.RunTip}" />
        </CommandBar>

        <!-- View options in one row: Show filter · View (group / sort) · Find. -->
        <Grid Grid.Row="2" ColumnSpacing="8" Padding="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" MaxWidth="280" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ShowBox" Width="200"
                      ItemsSource="{x:Bind ViewModel.ShowChoices}"
                      SelectedIndex="{x:Bind ViewModel.ShowIndex, Mode=TwoWay}"
                      ToolTipService.ToolTip="Show only this kind of item"
                      AutomationProperties.Name="Show" />
            <DropDownButton x:Name="ViewButton" Grid.Column="1"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ViewSummary, Mode=OneWay}"
                            AutomationProperties.Name="View options"
                            AutomationProperties.HelpText="{x:Bind ViewModel.ViewSummary, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                    <TextBlock x:Name="ViewButtonLabel" Text="View" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <RadioMenuFlyoutItem GroupName="Group" Text="Group by folder"
                                             Visibility="{x:Bind ViewModel.ShowFolderGrouping, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsGroupByFolder, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetGroupingCommand}" CommandParameter="Folder" />
                        <RadioMenuFlyoutItem GroupName="Group" Text="No grouping"
                                             Visibility="{x:Bind ViewModel.ShowNoGrouping, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsGroupByFolder, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetGroupingCommand}" CommandParameter="Folder" />
                        <RadioMenuFlyoutItem GroupName="Group" Text="Group by type"
                                             IsChecked="{x:Bind ViewModel.IsGroupByType, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetGroupingCommand}" CommandParameter="Category" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem GroupName="Sort" Text="Sort by name"
                                             IsChecked="{x:Bind ViewModel.IsSortByName, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetSortKeyCommand}" CommandParameter="Name" />
                        <RadioMenuFlyoutItem GroupName="Sort" Text="Sort by type"
                                             IsChecked="{x:Bind ViewModel.IsSortByType, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetSortKeyCommand}" CommandParameter="Type" />
                        <RadioMenuFlyoutItem GroupName="Sort" Text="Sort by size"
                                             IsChecked="{x:Bind ViewModel.IsSortBySize, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetSortKeyCommand}" CommandParameter="Size" />
                        <RadioMenuFlyoutItem GroupName="Sort" Text="Sort by location"
                                             IsChecked="{x:Bind ViewModel.IsSortByLocation, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetSortKeyCommand}" CommandParameter="Location" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem GroupName="Direction" Text="Ascending"
                                             IsChecked="{x:Bind ViewModel.IsAscending, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetSortDirectionCommand}" CommandParameter="Ascending" />
                        <RadioMenuFlyoutItem GroupName="Direction" Text="Descending"
                                             IsChecked="{x:Bind ViewModel.IsDescending, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.SetSortDirectionCommand}" CommandParameter="Descending" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <AutoSuggestBox Grid.Column="3" PlaceholderText="Find by name" QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Find by name" />
        </Grid>

        <!-- Column headers (match the item templates' columns). Click to sort; click again to reverse. -->
        <Grid Grid.Row="3" Padding="16,0,12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition x:Name="NameHeaderColumn" Width="*" MinWidth="100" />
                <ColumnDefinition x:Name="TypeHeaderColumn" Width="160" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="88" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" HorizontalContentAlignment="Left"
                    Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Name"
                    AutomationProperties.Name="Sort by name">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}" />
                    <FontIcon Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" FontSize="10" />
                </StackPanel>
            </Button>
            <Button x:Name="TypeHeaderButton" Grid.Column="2" Style="{StaticResource ColumnHeaderButton}"
                    HorizontalContentAlignment="Left"
                    Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Type"
                    AutomationProperties.Name="Sort by type">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                    <FontIcon Glyph="{x:Bind ViewModel.TypeSortGlyph, Mode=OneWay}" FontSize="10" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" HorizontalContentAlignment="Right"
                    Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Size"
                    AutomationProperties.Name="Sort by size">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}" FontSize="10" />
                    <TextBlock Text="Size" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" HorizontalContentAlignment="Left"
                    Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Location"
                    AutomationProperties.Name="Sort by location">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Location" Style="{StaticResource CaptionTextBlockStyle}" />
                    <FontIcon Glyph="{x:Bind ViewModel.LocationSortGlyph, Mode=OneWay}" FontSize="10" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="4">
            <ListView x:Name="VariablesList"
                      SelectionMode="Extended"
                      CanDragItems="True"
                      CanReorderItems="False"
                      ItemTemplate="{StaticResource WideItemTemplate}"
                      DragItemsStarting="OnDragItemsStarting"
                      DragItemsCompleted="OnDragItemsCompleted"
                      SelectionChanged="OnSelectionChanged"
                      RightTapped="OnListRightTapped"
                      KeyDown="OnListKeyDown"
                      AutomationProperties.Name="Variables on the calculator">
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Receive to folder…" Command="{x:Bind ViewModel.ReceiveCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.ReceiveToDefaultText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ReceiveToDefaultCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ReceiveToDefaultTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE840;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Rename…" Command="{x:Bind ViewModel.RenameCommand}"
                                        KeyboardAcceleratorTextOverride="F2"
                                        Visibility="{x:Bind ViewModel.ShowRename, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Rename" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Archive" Command="{x:Bind ViewModel.ArchiveCommand}"
                                        Visibility="{x:Bind ViewModel.ShowArchive, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Move to RAM" Command="{x:Bind ViewModel.UnarchiveCommand}"
                                        Visibility="{x:Bind ViewModel.ShowArchive, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE950;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Run" Command="{x:Bind ViewModel.RunCommand}"
                                        Visibility="{x:Bind ViewModel.ShowRun, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Play" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteCommand}"
                                        KeyboardAcceleratorTextOverride="Del">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Send files…" Command="{x:Bind ViewModel.SendFilesCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Upload" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="New folder…" Command="{x:Bind ViewModel.NewFolderCommand}"
                                        Visibility="{x:Bind ViewModel.ShowNewFolder, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="NewFolder" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:VariableGroup">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="The calculator has no variables. Drop files here or use Send files… to add some."
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Nothing matches the current Show / Find filter."
                       Visibility="{x:Bind ViewModel.IsFilteredEmpty, Mode=OneWay}" />

            <!-- Drop overlay while dragging files from Explorer. -->
            <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="8"
                    BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE898;" FontSize="40" />
                    <TextBlock Text="Drop to send to the calculator" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
