<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalcLink.App.Views.CalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CalcLink.App.ViewModels"
    xmlns:h="using:CalcLink.App.Helpers"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">

    <Grid Padding="24,16,24,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + memory summary -->
        <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Opacity="0.7" Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}"
                       Visibility="{x:Bind h:Format.VisibleIfNotEmpty(ViewModel.MemoryText), Mode=OneWay}" />
            <InfoBar Margin="0,8,0,0" Severity="Informational" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.Pending.HasPending, Mode=OneWay}"
                     Title="{x:Bind ViewModel.Pending.Title, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Pending.Summary, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Discard" Command="{x:Bind ViewModel.Pending.DiscardCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Commands. Tooltips explain why a command is disabled ("Not supported on ..."). -->
        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                    Background="Transparent">
            <AppBarButton Label="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.RefreshTip, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Send files…" Icon="Upload" Command="{x:Bind ViewModel.SendFilesCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SendTip, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Receive…" Icon="Download" Command="{x:Bind ViewModel.ReceiveCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.ReceiveTip, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Delete" Icon="Delete" Command="{x:Bind ViewModel.DeleteCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.DeleteTip, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Rename" Icon="Rename" Command="{x:Bind ViewModel.RenameCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.RenameTip, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F2" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Archive" Command="{x:Bind ViewModel.ArchiveCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.ArchiveTip, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Unarchive" Command="{x:Bind ViewModel.UnarchiveCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.UnarchiveTip, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="New folder" Icon="NewFolder" Command="{x:Bind ViewModel.NewFolderCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.NewFolderTip, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="N" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Run" Icon="Play" Command="{x:Bind ViewModel.RunCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.RunTip, Mode=OneWay}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="{x:Bind ViewModel.DefaultFolderText, Mode=OneWay}"
                              Command="{x:Bind ViewModel.ReceiveToDefaultCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- View options: what to show, how to group and sort, and a name filter. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Padding="4,0,0,0">
            <ComboBox Header="Show" MinWidth="170"
                      ItemsSource="{x:Bind ViewModel.ShowChoices}"
                      SelectedIndex="{x:Bind ViewModel.ShowIndex, Mode=TwoWay}"
                      AutomationProperties.Name="Show only this type of item" />
            <ComboBox Header="Group by" MinWidth="110"
                      ItemsSource="{x:Bind ViewModel.GroupChoices}"
                      SelectedIndex="{x:Bind ViewModel.GroupIndex, Mode=TwoWay}"
                      AutomationProperties.Name="Group items by" />
            <ComboBox Header="Sort by" MinWidth="140"
                      ItemsSource="{x:Bind ViewModel.SortChoices}"
                      SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                      AutomationProperties.Name="Sort items by" />
            <ToggleButton VerticalAlignment="Bottom" Padding="8,7"
                          IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SortDirectionText, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontSize="14" />
            </ToggleButton>
            <AutoSuggestBox Header="Find" Width="200" PlaceholderText="Name contains…" QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Filter by name" />
        </StackPanel>

        <!-- Column headers (match the item template's columns). Click to sort; click again to reverse. -->
        <Grid Grid.Row="3" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.Resources>
                <Style x:Key="ColumnHeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0,2" />
                    <Setter Property="Opacity" Value="0.75" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" HorizontalContentAlignment="Left"
                    Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Name"
                    AutomationProperties.Name="Sort by name">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}" />
                    <FontIcon Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" FontSize="10" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}" HorizontalContentAlignment="Left"
                    Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Type"
                    AutomationProperties.Name="Sort by type">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                    <FontIcon Glyph="{x:Bind ViewModel.TypeSortGlyph, Mode=OneWay}" FontSize="10" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" HorizontalContentAlignment="Right"
                    Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Size"
                    AutomationProperties.Name="Sort by size">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}" FontSize="10" />
                    <TextBlock Text="Size" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Location"
                    AutomationProperties.Name="Sort by RAM or archive">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Attribute" Style="{StaticResource CaptionTextBlockStyle}" />
                    <FontIcon Glyph="{x:Bind ViewModel.LocationSortGlyph, Mode=OneWay}" FontSize="10" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="4">
            <ListView x:Name="VariablesList"
                      SelectionMode="Extended"
                      CanDragItems="True"
                      CanReorderItems="False"
                      DragItemsStarting="OnDragItemsStarting"
                      DragItemsCompleted="OnDragItemsCompleted"
                      SelectionChanged="OnSelectionChanged"
                      RightTapped="OnListRightTapped"
                      AutomationProperties.Name="Variables on the calculator">
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Receive to folder…" Command="{x:Bind ViewModel.ReceiveCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Download" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.DefaultFolderText, Mode=OneWay}" Command="{x:Bind ViewModel.ReceiveToDefaultCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Rename…" Command="{x:Bind ViewModel.RenameCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Rename" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Move to archive" Command="{x:Bind ViewModel.ArchiveCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Move to RAM" Command="{x:Bind ViewModel.UnarchiveCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Run" Command="{x:Bind ViewModel.RunCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Play" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Send files…" Command="{x:Bind ViewModel.SendFilesCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Upload" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="New folder…" Command="{x:Bind ViewModel.NewFolderCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="NewFolder" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:VariableGroup">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VariableItem">
                        <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.Name="{x:Bind AutomationName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="16" Opacity="0.8" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind TypeName}" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" TextAlignment="Right" Opacity="0.8"
                                       VerticalAlignment="Center" />
                            <FontIcon Grid.Column="4" Glyph="{x:Bind AttributeGlyph}" FontSize="14"
                                      HorizontalAlignment="Center"
                                      ToolTipService.ToolTip="{x:Bind AttributeText}"
                                      AutomationProperties.Name="{x:Bind AttributeText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                       Text="The calculator has no variables. Drop files here or use Send files… to add some."
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                       Text="Nothing matches the current Show / Find filter."
                       Visibility="{x:Bind ViewModel.IsFilteredEmpty, Mode=OneWay}" />

            <!-- Drop overlay while dragging files from Explorer. -->
            <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="8"
                    BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE898;" FontSize="40" />
                    <TextBlock Text="Drop to send to the calculator" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
