<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CalcLink.Core</RootNamespace>
    <!-- Source-generated P/Invoke (LibraryImport) with pointers and function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No reflection/dynamic code: safe to trim and to publish NativeAOT. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comments on every public member are not worth a warning here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CalcLink.Core.Tests" />
  </ItemGroup>

</Project>
